# 使用说明：把本文件复制成 .env，再按下面的说明填值。
#   Windows PowerShell:  Copy-Item .env.example .env
# .env 已写进 .gitignore，不会被提交到 GitHub。

# 生成密钥（在项目根目录、已激活 venv 的情况下执行）：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 然后把输出的字符串粘到下面等号后面（建议保留双引号）
DJANGO_SECRET_KEY="在这里填入你自己生成的密钥"

# 开发时 True；部署到公网必须改成 False
DJANGO_DEBUG=True

# 允许访问的域名，逗号分隔。本地开发保持默认即可
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
